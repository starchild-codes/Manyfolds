{
  "name": "career-navigation",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --experimental-strip-types scripts/recommendation-quality-test.mjs && node scripts/dashboard-interaction-check.mjs && node scripts/auth-flow-check.mjs && node --experimental-strip-types scripts/ai-roadmap-architecture-test.mjs && node --experimental-strip-types scripts/programme-pilot-validation-test.mjs",
    "ai:evaluate": "node --experimental-strip-types scripts/evaluate-roadmap-models.mjs",
    "ai:evaluate:run": "node --experimental-strip-types scripts/evaluate-roadmap-models.mjs --run",
    "ai:evaluate:aggregate": "node scripts/aggregate-roadmap-evaluation.mjs",
    "ai:evaluate:persist": "node scripts/persist-roadmap-evaluation.mjs",
    "test:rls": "node scripts/rls-isolation-test.mjs",
    "data:sources:check:apply": "node scripts/check-catalogue-sources.mjs --apply",
    "data:scholarships:stage:apply": "node scripts/stage-nsp-scholarships.mjs --apply",
    "data:verified:coverage": "node scripts/verified-data-coverage.mjs",
    "test:evaluation-persistence": "node scripts/evaluation-persistence-test.mjs",
    "data:audit": "node scripts/data-audit.mjs",
    "data:import-pack": "node scripts/import-database-pack.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.0",
    "ajv": "^8.20.0",
    "csv-parse": "^7.0.1",
    "lucide-react": "^1.25.0",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.10.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
