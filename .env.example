# Manyfolds database and authentication
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated Supabase user UUIDs authorised to publish global catalogue data.
MANYFOLDS_CATALOGUE_CURATOR_IDS=

# Server-only AI roadmap generation. Never prefix these with VITE_.
OPENROUTER_API_KEY=
OPENROUTER_PRIMARY_MODEL=mistralai/mistral-small-3.2-24b-instruct
OPENROUTER_FALLBACK_MODELS=openai/gpt-4.1-mini
OPENROUTER_MAX_INPUT_TOKENS=2800
OPENROUTER_MAX_OUTPUT_TOKENS=1700
OPENROUTER_MAX_TOTAL_TOKENS=9000
OPENROUTER_MAX_COST_USD_PER_ROADMAP=
OPENROUTER_MAX_PROMPT_PRICE_PER_TOKEN=
OPENROUTER_MAX_COMPLETION_PRICE_PER_TOKEN=
MANYFOLDS_LIVE_DATA_ENABLED=false

# Server-only secret: at least 32 random characters for expiring document links.
DOCUMENT_SIGNING_SECRET=

# Local management only: configure Supabase Auth SMTP with npm run email:configure.
# Never prefix these with VITE_ or deploy the management access token.
SUPABASE_ACCESS_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
